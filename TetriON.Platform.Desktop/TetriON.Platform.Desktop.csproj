<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Icon.ico" />
        <None Remove="Icon.bmp" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Icon.ico">
        <LogicalName>Icon.ico</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Icon.bmp">
        <LogicalName>Icon.bmp</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
        <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TetriON.Client\TetriON.Client.csproj" />
        <ProjectReference Include="..\TetriON.Core\TetriON.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Content\GumProject\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="skins\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
        <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
        <Exec Command="dotnet tool restore" />
    </Target>

    <!-- Remove unwanted mobile runtimes after build -->
    <Target Name="CleanupMobileRuntimes" AfterTargets="Build;Publish">
        <ItemGroup>
            <UnwantedRuntimes Include="$(OutputPath)runtimes\android-arm\**\*" />
            <UnwantedRuntimes Include="$(OutputPath)runtimes\android-arm64\**\*" />
            <UnwantedRuntimes Include="$(OutputPath)runtimes\android-x64\**\*" />
            <UnwantedRuntimes Include="$(OutputPath)runtimes\android-x86\**\*" />
            <UnwantedRuntimes Include="$(OutputPath)runtimes\ios-arm64\**\*" />
            <UnwantedRuntimes Include="$(OutputPath)runtimes\iossimulator-arm64\**\*" />
            <UnwantedRuntimes Include="$(OutputPath)runtimes\iossimulator-x64\**\*" />
        </ItemGroup>
        <Delete Files="@(UnwantedRuntimes)" />
        <RemoveDir Directories="$(OutputPath)runtimes\android-arm;$(OutputPath)runtimes\android-arm64;$(OutputPath)runtimes\android-x64;$(OutputPath)runtimes\android-x86;$(OutputPath)runtimes\ios-arm64;$(OutputPath)runtimes\iossimulator-arm64;$(OutputPath)runtimes\iossimulator-x64" />
    </Target>
</Project>
