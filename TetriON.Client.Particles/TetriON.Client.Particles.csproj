<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
        <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">34</SupportedOSPlatformVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\TetriON.Core\TetriON.Core.csproj" />
        <ProjectReference Include="..\TetriON.Client.Rendering\TetriON.Client.Rendering.csproj" />
        <ProjectReference Include="..\TetriON.Client.Abstraction\TetriON.Client.Abstraction.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MonoGame.Extended" Version="5.3.1" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" Condition="'$(TargetFramework)' == 'net10.0'" />
        <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" Condition="'$(TargetFramework)' == 'net10.0-android'" />
    </ItemGroup>
</Project>
